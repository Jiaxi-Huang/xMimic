<mujoco model="dex_evt (tiangong2) flat terrain scene">
  <include file="dex_evt.xml" />

  <statistic center="0 0 0.5" extent="2.0" />
  <option iterations="3" />

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
    <rgba haze="0.1 0.1 0.1 1" />
    <global azimuth="120" elevation="-20" />
  </visual>

  <asset>
    <texture name="skybox" type="skybox" builtin="gradient" rgb1="0.4 0.4 0.4" rgb2="0 0 0"
      width="512" height="512" />
    <texture name="motphys-ground" type="2d" file="motphys-ground.png" />
    <material name="groundplane" texture="motphys-ground" texuniform="true" texrepeat="0.4 0.4" />
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true" />
    <geom name="floor" size="0 0 0.01" type="plane" material="groundplane" contype="1"
      conaffinity="1" priority="1" friction="0.8" condim="3" />
  </worldbody>

  <keyframe>
    <key name="home"
      qpos="0 0 0.98 1 0 0 0
      -0.25 0 0 0.5 -0.25 0
      -0.25 0 0 0.5 -0.25 0
      0 0 0
      0 0.3 0 -0.3
      0 -0.3 0 -0.3" />
  </keyframe>
</mujoco>